{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "API_TYPE": "custom",
    "CUSTOM_API_KEY": "@custom_api_key",
    "CUSTOM_API_URL": "https://api.deapi.ai/v1/images/generate"
  }
}
